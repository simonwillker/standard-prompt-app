{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "category",
        "tags",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "task",
        "input_spec",
        "variables",
        "output",
        "missing_info"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "input_spec": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "type",
              "placement",
              "required"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "text",
                  "textarea",
                  "number",
                  "boolean",
                  "date",
                  "select"
                ]
              },
              "placement": {
                "enum": [
                  "input",
                  "inline"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "default": {},
              "description": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            }
          }
        },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "template"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "markdown",
                    "text"
                  ]
                },
                "template": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "schema"
              ],
              "properties": {
                "type": {
                  "const": "json"
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          ]
        },
        "examples": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              },
              "output": {}
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_info": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy"
              ],
              "properties": {
                "policy": {
                  "const": "ask"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy",
                "value"
              ],
              "properties": {
                "policy": {
                  "const": "mark_unknown"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_profile"
      ],
      "properties": {
        "api_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "provider",
            "model",
            "temperature",
            "max_retries"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "temperature": {
              "type": "number"
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
